---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Base title="Поиск" noIndex><Breadcrumbs items={[{label:'Поиск'}]}/><div class="page-intro"><span class="eyebrow">INDEX RERUM</span><h1>Найти в Римском мире</h1><p>Ищите людей, места, события, исследования и предметы — на русском или по древнему названию.</p></div><form class="search-form" role="search"><label for="global-search" class="sr-only">Поисковый запрос</label><input id="global-search" name="q" type="search" placeholder="Например, Август или Roma" autocomplete="off"/><button type="submit">Найти</button></form><p class="search-status" role="status">Введите имя, место или тему. Поиск находит слова и точные фразы.</p><div class="filters" id="search-filters" hidden aria-label="Тип результата"></div><div class="search-results" id="search-results"></div><noscript><p class="notice">Поиск работает в браузере и требует JavaScript. Все разделы доступны через основное меню.</p></noscript>
<script>
 type SearchData={url:string;meta:Record<string,string>;excerpt:string;filters?:Record<string,string[]>};type Result={data:()=>Promise<SearchData>};type Pagefind={filters:()=>Promise<Record<string,Record<string,number>>>;options:(options:unknown)=>Promise<void>;search:(query:string,options?:{filters?:Record<string,string>})=>Promise<{results:Result[];filters:Record<string,Record<string,number>>}>};
 const form=document.querySelector<HTMLFormElement>('.search-form')!;const input=document.querySelector<HTMLInputElement>('#global-search')!;const status=document.querySelector<HTMLElement>('.search-status')!;const list=document.querySelector<HTMLElement>('#search-results')!;const filters=document.querySelector<HTMLElement>('#search-filters')!;
 let engine:Pagefind|undefined;let request=0;let type='';let timer:ReturnType<typeof setTimeout>;
 // Pagefind excerpts contain only its highlight markup; reconstruct text and mark nodes.
 function excerpt(html:string){const parsed=new DOMParser().parseFromString(html,'text/html');const fragment=document.createDocumentFragment();function copy(node:Node,parent:Node){if(node.nodeType===Node.TEXT_NODE)parent.appendChild(document.createTextNode(node.textContent||''));else if(node instanceof Element){if(node.tagName==='MARK'){const mark=document.createElement('mark');parent.appendChild(mark);node.childNodes.forEach(n=>copy(n,mark));}else node.childNodes.forEach(n=>copy(n,parent));}}parsed.body.childNodes.forEach(n=>copy(n,fragment));return fragment;}
 async function search(reset=true){const serial=++request;const q=input.value.trim();if(reset)type='';list.replaceChildren();if(!q){status.textContent='Введите имя, место или тему. Поиск находит слова и точные фразы.';filters.hidden=true;return;}status.textContent='Поиск…';const u=new URL(location.href);u.searchParams.set('q',q);history.replaceState(null,'',u);
 try{const modulePath='/pagefind/pagefind.js';if(!engine){engine=await import(/* @vite-ignore */ modulePath) as Pagefind;await engine.options({ranking:{metaWeights:{title:15,aliases:8},termFrequency:0.6}});await engine.filters();}const result=await engine.search('\"'+q.replaceAll('\"','')+'\"',type?{filters:{type}}:undefined);if(serial!==request)return;const data=await Promise.all(result.results.slice(0,40).map(r=>r.data()));if(serial!==request)return;status.textContent=result.results.length?`Найдено: ${result.results.length}${result.results.length>40?' · показаны первые 40':''}`:'Ничего не найдено. Попробуйте другое имя или более короткий запрос.';
 if(reset){filters.replaceChildren();const types=result.filters?.type||{};filters.hidden=Object.keys(types).length<2;if(!filters.hidden){for(const [value,label] of [['','Все'],...Object.keys(types).filter(t=>types[t]>0).map(t=>[t,t])]){const b=document.createElement('button');b.className='filter';b.textContent=label;b.type='button';b.setAttribute('aria-pressed',String(!value));b.addEventListener('click',()=>{type=value;filters.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));void search(false)});filters.append(b)}}}
 const normalized=q.toLocaleLowerCase('ru');data.sort((a,b)=>Number((b.meta.title||'').toLocaleLowerCase('ru').includes(normalized))-Number((a.meta.title||'').toLocaleLowerCase('ru').includes(normalized)));for(const item of data){const a=document.createElement('a');a.href=item.url;const small=document.createElement('small');small.textContent=item.filters?.type?.[0]||'Материал';const title=document.createElement('h3');title.textContent=item.meta.title||item.url;const p=document.createElement('p');p.append(excerpt(item.excerpt));a.append(small,title,p);list.append(a)}
 }catch{if(serial!==request)return;status.textContent='Не удалось загрузить поисковый индекс. Проверьте соединение и нажмите «Найти» ещё раз.';filters.hidden=true;}}
 form.addEventListener('submit',e=>{e.preventDefault();clearTimeout(timer);void search()});input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>void search(),250)});const initial=new URLSearchParams(location.search).get('q');if(initial){input.value=initial;void search();}
</script>
</Base>
