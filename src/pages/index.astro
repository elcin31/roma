---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import Atlas from '../components/Atlas';
import {atlasPlaces} from '../lib/atlas-data';
import {getEntity,ofKind} from '../lib/catalog';
import {entityUrl,formatDate} from '../lib/schema';
const periods=ofKind('period');
---
<Base title="ROMA">
<section class="hero"><div class="hero-copy"><span class="eyebrow">ДВАДЦАТЬ ДВА ВЕКА · ОДНА ИСТОРИЯ</span><h1>ROMA<span>AETERNA</span></h1><p class="hero-lead">Город, который стал миром.</p><p class="hero-note">От первых поселений на Тибре до последнего дня Константинополя. Исследуйте историю Рима через людей, места и вещи.</p><a class="text-link" href="/history/">Начать путешествие <span aria-hidden="true">→</span></a></div><figure class="hero-art"><img src="/images/met-247993.webp" alt="Мраморный портрет императора Августа из собрания Metropolitan Museum" width="1125" height="1500" fetchpriority="high"/><span class="hero-mark" aria-hidden="true">SPQR</span><figcaption><span>Мраморный портрет Августа<br/>Около 14–37 н. э.</span><a href="/collection/met-247993/">The Met · Open Access →</a></figcaption></figure></section>
<div class="hero-bottom"><span>ИСТОРИЯ · ГЕОГРАФИЯ · КУЛЬТУРА</span><span>RES PUBLICA POPULI ROMANI</span><span>ИССЛЕДУЙТЕ НИЖЕ ↓</span></div>
<section class="section"><div class="section-heading"><span class="section-number">01</span><h2>Время Рима</h2><a class="text-link" href="/timeline/">Вся хронология <span>→</span></a></div><div class="period-strip">{periods.map((p,i)=><a href={entityUrl(p)} class="period-item"><span class="year">{formatDate(p.date)}</span><h3>{p.title}</h3><span class="period-roman">{['I','II','III','IV','V'][i]} <span aria-hidden="true">→</span></span></a>)}</div></section>
<section class="atlas-band"><div class="atlas-intro"><div><span class="eyebrow">02 / ИСТОРИЧЕСКИЙ АТЛАС</span><h2 style="margin-top:14px">Мир, связанный Римом</h2></div><p>Города, дороги и меняющиеся границы. Исследуйте Средиземноморье по историческим геоданным.</p></div><Atlas places={atlasPlaces} preview client:visible/><noscript><p>Для интерактивной карты включите JavaScript. <a href="/places/">Справочник городов</a> доступен без него.</p></noscript></section>
<section class="section"><div class="section-heading"><span class="section-number">03</span><span class="eyebrow">В ФОКУСЕ · ОБЩЕСТВО</span></div><div class="feature-story"><figure><img src="/images/met-247008.webp" alt="Красная настенная роспись виллы в Боскореале" width="1400" height="1020" loading="lazy"/><figcaption>Вилла в Боскореале. Около 50–40 до н. э. · The Met, CC0</figcaption></figure><div><span class="eyebrow muted">ПОВСЕДНЕВНАЯ ЖИЗНЬ / 8 МИН ЧТЕНИЯ</span><h2>За порогом<br/>римского дома</h2><p>Место семейной жизни, политических встреч и невидимого труда. Что фрески и архитектура рассказывают о людях, живших две тысячи лет назад.</p><a class="text-link" href="/articles/roman-home/">Читать исследование <span>→</span></a></div></div></section>
<section class="section" style="border-top:1px solid var(--line)"><div class="people-feature"><div class="people-feature-intro"><div class="section-heading"><span class="section-number">04</span><h2>Люди и власть</h2></div><p>За большими переменами — личные решения, семейные связи и борьба за будущее.</p><a class="text-link" style="margin-top:25px" href="/people/">Все личности <span>→</span></a></div><div class="people-rows">{['caesar','augustus','livia','justinian'].map((id,i)=>{const p=getEntity(id);return <a href={entityUrl(p)}><span class="index">0{i+1}</span><div><h3>{p.title}</h3><small>{formatDate(p.date)} · {p.roles?.[0]}</small></div><span aria-hidden="true">→</span></a>})}</div></div></section>
<section class="section"><div class="section-heading"><span class="section-number">05</span><h2>Вещи, пережившие время</h2><a class="text-link" href="/collection/">Вся коллекция <span>→</span></a></div><div class="object-grid">{['met-248132','met-256570','met-250945'].map(id=><Entry entity={getEntity(id)} image/>)}</div></section>
<section class="section"><div class="section-heading"><span class="section-number">06</span><h2>Исследовать Римский мир</h2></div><div class="themes">{[['Политика','/articles/constitution/'],['Войны и армия','/army/'],['Дом и общество','/society/'],['Право и свобода','/articles/justinian-law/'],['Искусство','/collection/?theme=Живопись'],['Религия','/collection/met-256570/']].map(([title,url])=><a href={url}>{title}<span aria-hidden="true">→</span></a>)}</div></section>
<section class="section"><div class="sources-teaser"><div><span class="eyebrow">07 / AD FONTES</span><h2 style="margin-top:18px">История начинается<br/>с источника</h2></div><div><p>Античное свидетельство, музейный каталог и современное исследование отвечают на разные вопросы. Мы сохраняем эти различия и показываем, на чём основан каждый материал.</p><a class="text-link" href="/sources/">Библиотека источников <span>→</span></a></div></div></section>
</Base>
