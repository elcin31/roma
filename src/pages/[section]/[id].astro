---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Bookmark from '../../components/Bookmark.astro';
import Entry from '../../components/Entry.astro';
import Contents from '../../components/Contents.astro';
import MuseumImage from '../../components/MuseumImage.astro';
import imageMetadata from '../../data/image-metadata.json';
import {entities,getEntity,related,inPeriod,chronological} from '../../lib/catalog';
import {kindRoutes,kindLabels,entityUrl,formatDate} from '../../lib/schema';
export function getStaticPaths(){return entities.filter(e=>e.kind!=='article').map(e=>({params:{section:kindRoutes[e.kind],id:e.id}}));}
const e=getEntity(Astro.params.id!);const isObject=e.kind==='object';const connections=related(e.id).filter(x=>x.kind!=='source');const events=chronological((e.kind==='period'?inPeriod(e.id):connections).filter(x=>x.kind==='event'||x.kind==='battle'));
const sections=e.sections.map((s,i)=>({...s,anchor:`section-${i+1}`}));const periodArticles=e.kind==='period'?inPeriod(e.id).filter(x=>x.kind==='article'):[];const periodPeople=e.kind==='period'?inPeriod(e.id).filter(x=>x.kind==='person'):[];
const imageDimensions=e.image?(imageMetadata as Record<string,{width:number;height:number}>)[e.image]:undefined;
const sourceLabels={primary:'Античное свидетельство',research:'Современное исследование',catalogue:'Каталог',geodata:'Геоданные'};
---
<Base title={e.title} description={e.summary}><Breadcrumbs items={[{label:kindLabels[e.kind],href:`/${kindRoutes[e.kind]}/`},{label:e.title}]}/><article data-pagefind-body data-pagefind-filter={`type:${kindLabels[e.kind]}`}><div class:list={['entity-hero',!e.image&&'no-image']}><div><span class="eyebrow">{isObject?'МУЗЕЙНАЯ КОЛЛЕКЦИЯ':e.sourceType?sourceLabels[e.sourceType]:kindLabels[e.kind]}</span><h1 data-pagefind-meta="title">{e.title}</h1>{e.subtitle&&<p class="latin">{e.subtitle}</p>}{e.date&&<p class="dates">{isObject?e.objectDate:formatDate(e.date)}</p>}<p class="lead" data-pagefind-meta="description">{e.summary}</p><Bookmark id={e.id}/></div>{e.image&&<figure><div class="object-view"><MuseumImage src={e.image} alt={e.title} sizes="(max-width:767px) 90vw, 38vw" loading="eager" fetchpriority="high"/>{isObject&&<button id="zoom-image" aria-haspopup="dialog" disabled aria-busy="true" title="Просмотр загружается">Увеличить изображение →</button>}</div><figcaption style="font-size:10px;color:var(--muted);margin-top:10px">{isObject?'The Metropolitan Museum of Art · CC0':<>Портрет Августа · The Met, CC0. <a href="/collection/met-247993/">О предмете →</a></>}</figcaption></figure>}</div>
<span class="sr-only" data-pagefind-meta="aliases">{e.aliases.join(' · ')}</span>
<div class="reading-layout"><Contents label="В этом материале" items={[...sections.map(s=>({href:`#${s.anchor}`,label:s.title})),...(events.length?[{href:'#events',label:'Хронология'}]:[]),...(e.kind==='place'?[{href:`/atlas/?place=${e.id}`,label:'Открыть на карте →'}]:[]),...(e.sourceIds.length?[{href:'#bibliography',label:'Источники'}]:[]),{href:'#related',label:'Связанные материалы'}]}/><div class="prose">
{(isObject||e.kind==='person'||e.kind==='place'||e.kind==='source'||e.kind==='dataset'||e.kind==='battle')&&<div class="facts" data-pagefind-ignore><dl>
{e.roles&&<><dt>Должности и титулы</dt><dd>{e.roles.join(' · ')}</dd></>}{e.family&&<><dt>Семейные связи</dt><dd>{e.family}</dd></>}
{isObject&&<><dt>Музей</dt><dd>{e.museum}</dd><dt>Инвентарный номер</dt><dd>{e.accessionNumber}</dd><dt>Материал</dt><dd>{e.material}</dd><dt>Размеры · формулировка музея</dt><dd>{e.dimensions}</dd><dt>Происхождение</dt><dd>{e.findspot}</dd><dt>Поступление в коллекцию</dt><dd>{e.provenance}</dd><dt>Права на фотографию</dt><dd>{e.license}</dd><dt>Оригинальная запись</dt><dd><a href={e.url}>Открыть каталог Met →</a></dd></>}
{e.kind==='place'&&<><dt>Современное место</dt><dd>{e.modernName}</dd><dt>Принадлежность и период</dt><dd>{e.province}</dd><dt>Координаты Pleiades</dt><dd>{e.coordinates?.[1].toFixed(5)}, {e.coordinates?.[0].toFixed(5)} · {e.coordinateAccuracy}</dd><dt>Научный идентификатор</dt><dd><a href={e.url}>Pleiades {e.pleiadesId} →</a></dd></>}
{e.kind==='source'&&<><dt>Доступный текст</dt><dd><a href={e.url}>Открыть источник →</a></dd><dt>Тип свидетельства</dt><dd>{e.sourceType&&sourceLabels[e.sourceType]}</dd></>}
{e.kind==='dataset'&&<><dt>Лицензия</dt><dd>{e.license}</dd><dt>Версия</dt><dd>{e.version}</dd><dt>Источник</dt><dd><a href={e.url}>Оригинальный набор →</a> · <a href="/credits/">Манифест и загрузка данных</a></dd></>}
{e.kind==='battle'&&<><dt>Противники</dt><dd>{e.opponents?.join(' / ')}</dd><dt>Командующие</dt><dd>{e.commanders?.map((id,i)=><>{i>0?'; ':''}<a href={entityUrl(getEntity(id))}>{getEntity(id).title}</a></>)}</dd>{e.placeId&&<><dt>Место</dt><dd><a href={entityUrl(getEntity(e.placeId))}>{getEntity(e.placeId).title}</a> · <a href={`/atlas/?place=${e.placeId}`}>На карте</a></dd></>}</>}
</dl></div>}
{sections.map(s=><section><h2 id={s.anchor}>{s.title}</h2><p>{s.text}</p><p style="font-family:var(--sans);font-size:11px">{s.sourceIds.filter(id=>id!==e.id).map((id,i)=><>{i>0?' · ':''}<a href={entityUrl(getEntity(id))}>{getEntity(id).title}</a></>)}</p></section>)}
{events.length>0&&<section id="events"><h2>Хронология</h2><div class="timeline-list">{events.map(ev=><a href={entityUrl(ev)} class="timeline-item"><time>{formatDate(ev.date)}</time><div><h3>{ev.title}</h3></div></a>)}</div></section>}
{e.kind==='period'&&<div class="notice">Исторические карты опубликованы только для трёх подтверждённых срезов: 60 до н. э., 117 и 200 н. э. <a href="/atlas/">Открыть атлас →</a></div>}
{e.sourceIds.length>0&&<section class="bibliography" id="bibliography"><h2>Источники и исследования</h2>{e.sourceIds.map(id=>{const s=getEntity(id);return <a href={entityUrl(s)}>{s.title} →</a>})}</section>}
<div class="review-note" data-pagefind-ignore>Редакционная сверка: {e.review?.date}. {e.review?.scope} <a href="/about/">Как мы работаем с источниками</a>.</div>
</div></div></article>
{periodArticles.length>0&&<section class="related-section"><h2>Исследования эпохи</h2><div class="index-grid">{periodArticles.map(x=><Entry entity={x}/>)}</div></section>}
{periodPeople.length>0&&<section class="related-section"><h2>Люди эпохи</h2><div class="index-grid">{periodPeople.map(x=><Entry entity={x}/>)}</div></section>}
<section id="related" class="related-section" data-pagefind-ignore><h2>Продолжить исследование</h2><div class="index-grid">{connections.slice(0,10).map(x=><Entry entity={x}/>)}</div>{connections.length===0&&<a class="text-link" href={e.kind==='dataset'?'/atlas/':'/sources/'}>К {e.kind==='dataset'?'атласу':'источникам'} →</a>}</section>
{isObject&&e.image&&imageDimensions&&<dialog class="image-dialog" id="image-dialog" aria-labelledby="viewer-title" style={`--image-width:${imageDimensions.width}px`}><div class="image-dialog-toolbar"><span id="viewer-title">Музейный просмотр</span><button id="toggle-image-size" aria-pressed="false">Увеличить до исходного размера</button><button id="close-image" autofocus>Закрыть ×</button></div><div class="image-dialog-viewport" role="region" tabindex="0" aria-label="Изображение с прокруткой"><img src={e.image} alt={e.title} width={imageDimensions.width} height={imageDimensions.height}/></div><div class="image-dialog-caption"><p>{e.title} · {e.objectDate} · {e.museum} · {e.accessionNumber} · CC0</p><a href={e.url}>Оригинал и дополнительные изображения в Met →</a></div></dialog>}

<script>
 const zoom=document.querySelector<HTMLButtonElement>('#zoom-image');
 const dialog=document.querySelector<HTMLDialogElement>('#image-dialog');
 const size=document.querySelector<HTMLButtonElement>('#toggle-image-size');
 let previousOverflow='';
 zoom?.addEventListener('click',()=>{if(!dialog)return;previousOverflow=document.documentElement.style.overflow;dialog.showModal();document.documentElement.style.overflow='hidden';});
 size?.addEventListener('click',()=>{const enlarged=size.getAttribute('aria-pressed')!=='true';size.setAttribute('aria-pressed',String(enlarged));size.textContent=enlarged?'Вписать изображение':'Увеличить до исходного размера';dialog?.classList.toggle('is-enlarged',enlarged);});
 document.querySelector('#close-image')?.addEventListener('click',()=>dialog?.close());
 dialog?.addEventListener('close',()=>{document.documentElement.style.overflow=previousOverflow;dialog.classList.remove('is-enlarged');size?.setAttribute('aria-pressed','false');if(size)size.textContent='Увеличить до исходного размера';zoom?.focus({preventScroll:true});});
 dialog?.addEventListener('click',event=>{if(event.target===dialog){const rect=dialog.getBoundingClientRect();if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)dialog.close();}});
 if(zoom&&dialog){zoom.disabled=false;zoom.removeAttribute('aria-busy');zoom.removeAttribute('title');}
</script>
</Base>
