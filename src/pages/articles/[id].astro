---
import {getCollection,render} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Bookmark from '../../components/Bookmark.astro';
import Entry from '../../components/Entry.astro';
import {getEntity,related,byId} from '../../lib/catalog';
import {entityUrl} from '../../lib/schema';
export async function getStaticPaths(){return (await getCollection('articles')).filter(a=>a.data.status==='verified'&&byId.has(a.data.entityId)).map(entry=>({params:{id:entry.data.entityId},props:{entry}}));}
const {entry}=Astro.props;const e=getEntity(entry.data.entityId);const {Content,headings}=await render(entry);const minutes=Math.ceil((entry.body?.split(/\s+/).length||0)/160);const links=related(e.id).filter(x=>x.kind!=='source');
---
<Base title={e.title} description={e.summary}><Breadcrumbs items={[{label:'Исследования',href:'/articles/'},{label:e.title}]}/><article data-pagefind-body data-pagefind-filter="type:Исследование"><div class="entity-hero no-image"><span class="eyebrow">ИССЛЕДОВАНИЕ · {e.tags.join(' / ')} · {minutes} МИН ЧТЕНИЯ</span><h1 data-pagefind-meta="title">{e.title}</h1><p class="lead" data-pagefind-meta="description">{e.summary}</p><Bookmark id={e.id}/></div><div class="reading-layout"><aside class="toc" data-pagefind-ignore><span class="eyebrow">ОГЛАВЛЕНИЕ</span>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<a href="#bibliography">Источники и библиография</a><a href="/atlas/?place=roma">Рим на карте →</a></aside><div class="prose"><Content/><section class="bibliography" id="bibliography"><h2>Источники и библиография</h2>{e.sourceIds.map(id=>{const s=getEntity(id);return <div><a href={entityUrl(s)}>{s.title} →</a><p>{s.sections[0]?.text}</p></div>})}<div class="notice">Текст — оригинальное изложение ROMA. Античные авторы рассматриваются как исторические свидетельства со своей позицией, а не как беспристрастные очевидцы всех описанных событий.</div></section><div class="review-note" data-pagefind-ignore>Редакционная сверка: {e.review?.date}. {e.review?.scope} <a href="/about/">Редакционные принципы</a>.</div></div></div></article><section class="related-section" data-pagefind-ignore><h2>Продолжить исследование</h2><div class="index-grid">{links.map(x=><Entry entity={x}/>)}</div></section></Base>
