---
import {entityUrl,formatDate,kindLabels,type Entity} from '../lib/schema';
interface Props {entity:Entity;number?:number;image?:boolean;}
const {entity,number,image=false}=Astro.props;
---
<a class:list={['entry',image&&'entry-image']} href={entityUrl(entity)}>{image&&entity.image&&<div class="entry-art"><img src={entity.image.replace('.webp','-small.webp')} alt={entity.title} width="600" height="700" loading="lazy"/></div>}<div class="entry-meta"><span>{number!==undefined?String(number).padStart(2,'0'):kindLabels[entity.kind]}</span><span>{entity.objectDate||formatDate(entity.date)}</span></div><h3>{entity.title}<span aria-hidden="true">→</span></h3><p>{entity.summary}</p></a>
