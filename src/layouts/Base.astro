---
import '../styles/global.css';
import '@fontsource/literata/cyrillic-400.css';
import '@fontsource/literata/latin-400.css';
import '@fontsource/literata/cyrillic-500.css';
import '@fontsource/literata/latin-500.css';
import '@fontsource/manrope/cyrillic-400.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/cyrillic-600.css';
import '@fontsource/manrope/latin-600.css';
interface Props {title:string; description?:string; wide?:boolean; noIndex?:boolean;}
const {title,description='ROMA — цифровой музей истории Римского мира. История, люди, подлинные предметы и интерактивный атлас.',wide=false,noIndex=false}=Astro.props;
const nav=[['История','/history/'],['Личности','/people/'],['Войны и армия','/army/'],['Общество','/society/'],['Атлас','/atlas/'],['Коллекция','/collection/'],['Источники','/sources/']];
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#F5F1E8"/><meta name="description" content={description}/>{noIndex&&<meta name="robots" content="noindex"/>}<title>{title==='ROMA'?'ROMA — цифровой музей Римского мира':`${title} — ROMA`}</title><meta property="og:title" content={`${title} — ROMA`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head>
<body><a class="skip-link" href="#main">Перейти к содержанию</a>
<header class="site-header" data-pagefind-ignore><div class="masthead wrap"><a class="wordmark" href="/" aria-label="ROMA — главная">ROMA<span class="wordmark-dot">.</span></a><span class="masthead-note">ЦИФРОВОЙ МУЗЕЙ<br/>РИМСКОГО МИРА</span><div class="header-actions"><a href="/library/" class="library-link">Моя библиотека <span aria-hidden="true">→</span></a><a class="search-link" href="/search/" aria-label="Поиск"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.5"/></svg><span>Поиск</span></a><button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Меню <span aria-hidden="true">☰</span></button></div></div>
<nav id="main-nav" class="main-nav wrap" aria-label="Основная навигация">{nav.map(([label,url])=><a href={url} aria-current={Astro.url.pathname.startsWith(url)?'page':undefined}>{label}</a>)}<a class="mobile-library" href="/library/">Моя библиотека</a></nav></header>
<main id="main" class:list={[!wide&&'wrap']}><slot/></main>
<footer class="site-footer" data-pagefind-ignore><div class="wrap footer-top"><div><a class="wordmark" href="/">ROMA.</a><p>Прошлое, к которому можно<br/>возвращаться.</p></div><div><span class="eyebrow">ИССЛЕДОВАТЬ</span><a href="/timeline/">Хронология</a><a href="/places/">Города Римского мира</a><a href="/library/">Моя библиотека</a></div><div><span class="eyebrow">О ПРОЕКТЕ</span><a href="/about/">Редакционные принципы</a><a href="/credits/">Источники и права</a><a href="https://github.com/elcin31/roma">Открытый код →</a></div><p class="footer-note">Независимый образовательный проект.<br/>Без регистрации и рекламы.<br/>С вниманием к источникам.</p></div><div class="wrap footer-bottom"><span>ROMA · EDITIO I · 2026</span><span>Historia magistra vitae</span><a href="#main">К началу ↑</a></div></footer>
<script>
 const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector<HTMLElement>('#main-nav');
 toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open)});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){toggle.setAttribute('aria-expanded','false');nav?.classList.remove('is-open');toggle.focus()}});
</script>
</body></html>
